# === Required ===
APRL_REPORT_PATH=./input/report.xlsx

# === ADO Export ===
ADO_WORK_ITEM_TYPE_EPIC=Epic
ADO_WORK_ITEM_TYPE_FEATURE=Feature
ADO_WORK_ITEM_TYPE_STORY=User Story
ADO_WORK_ITEM_TYPE_TASK=Task
ADO_AREA_PATH=
ADO_ITERATION_PATH=

# === GitHub Export ===
GITHUB_REPO=                   # owner/repo format (e.g. myorg/myrepo)
GITHUB_MILESTONE=              # optional milestone name for all issues
GITHUB_ASSIGNEE=               # optional default assignee username
GITHUB_EXTRA_LABELS=           # optional comma-separated additional labels

# === Optional — Azure OpenAI ===
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-01

# === Web Dashboard ===
FLASK_PORT=5000
