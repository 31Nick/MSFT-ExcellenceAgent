<h1>{{ title }}</h1>
<h2>Overview</h2>
<p>Consolidated APRL recommendations for <strong>{{ resource_type }}</strong> resources.</p>
<ul>
<li><strong>Impact:</strong> {{ impact }}</li>
<li><strong>WAF Pillars:</strong> {{ waf_pillars | join(', ') }}</li>
<li><strong>Recommendations:</strong> {{ tasks | length }}</li>
<li><strong>Affected Resources:</strong> {{ resource_count }}</li>
<li><strong>Source:</strong> {{ source }}</li>
</ul>
<h2>Recommendations Summary</h2>
<table>
<tr><th>#</th><th>Recommendation</th><th>Impact</th><th>WAF Pillar</th><th>Affected Resources</th></tr>
{% for task in tasks -%}
<tr><td>{{ loop.index }}</td><td>{{ task.title }}</td><td>{{ task.impact }}</td><td>{{ task.waf_pillar }}</td><td>{{ task.affected_resources | length }}</td></tr>
{% endfor -%}
</table>
