<h1>{{ title }}</h1>
<h2>Overview</h2>
<p>Consolidated APRL recommendations for <strong>{{ resource_type }}</strong> resources.</p>
<ul>
<li><strong>Impact:</strong> {{ impact }}</li>
<li><strong>WAF Pillars:</strong> {{ waf_pillars | join(', ') }}</li>
<li><strong>Recommendations:</strong> {{ recommendations | length }}</li>
<li><strong>Affected Resources:</strong> {{ resource_count }}</li>
<li><strong>Source:</strong> {{ source }}</li>
</ul>
<h2>Recommendations</h2>
{% for rec in recommendations -%}
<h3>{{ loop.index }}. {{ rec.title }} [{{ rec.impact }}]</h3>
<p>{{ rec.long_description or 'No detailed description available.' }}</p>
<ul>
<li><strong>WAF Pillar:</strong> {{ rec.waf_pillar or 'N/A' }}</li>
<li><strong>Control:</strong> {{ rec.recommendation_control }}</li>
<li><strong>Benefit:</strong> {{ rec.potential_benefit or 'N/A' }}</li>
<li><strong>GUID:</strong> <code>{{ rec.recommendation_guid }}</code></li>
{% if rec.learn_more_link -%}
<li><strong>Learn more:</strong> <a href="{{ rec.learn_more_link }}">{{ rec.learn_more_link }}</a></li>
{% endif -%}
</ul>
<p><strong>Affected Resources ({{ rec.affected_resources | length }}):</strong></p>
<table>
<tr><th>Resource</th><th>Resource Group</th><th>Location</th><th>Subscription</th></tr>
{% for res in rec.affected_resources -%}
<tr><td>{{ res.resource_name }}</td><td>{{ res.resource_group }}</td><td>{{ res.location }}</td><td>{{ res.subscription_id }}</td></tr>
{% endfor -%}
</table>
{% endfor -%}
